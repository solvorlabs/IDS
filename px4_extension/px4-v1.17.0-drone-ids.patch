@@ -0,0 +1,141 @@
+/****************************************************************************
+ * Simulation-only attack scheduler for Drone IDS experiments.
+ * This module is enabled only in the PX4 SITL test board.
+ ****************************************************************************/
+
+#include <px4_platform_common/log.h>
+#include <px4_platform_common/module.h>
+#include <px4_platform_common/px4_work_queue/ScheduledWorkItem.hpp>
+
+#include <uORB/Publication.hpp>
+#include <uORB/topics/debug_key_value.h>
+#include <uORB/topics/drone_ids_sim_control.h>
+#include <uORB/topics/vehicle_command.h>
+
+#include <cstring>
+
+using namespace time_literals;
+
+class DroneIdsSim final : public ModuleBase<DroneIdsSim>, public px4::ScheduledWorkItem
+{
+public:
+	DroneIdsSim() : ScheduledWorkItem(MODULE_NAME, px4::wq_configurations::hp_default) {}
+	~DroneIdsSim() override = default;
+
+	static int task_spawn(int argc, char *argv[])
+	{
+		DroneIdsSim *instance = new DroneIdsSim();
+
+		if (instance == nullptr) {
+			PX4_ERR("allocation failed");
+			return PX4_ERROR;
+		}
+
+		_object.store(instance);
+		_task_id = task_id_is_work_queue;
+
+		if (instance->init()) {
+			return PX4_OK;
+		}
+
+		delete instance;
+		_object.store(nullptr);
+		_task_id = -1;
+		return PX4_ERROR;
+	}
+
+	static int custom_command(int argc, char *argv[]) { return print_usage("unknown command"); }
+	static int print_usage(const char *reason = nullptr)
+	{
+		if (reason) { PX4_WARN("%s", reason); }
+		PRINT_MODULE_USAGE_NAME("drone_ids_sim", "simulation");
+		PRINT_MODULE_USAGE_COMMAND("start");
+		PRINT_MODULE_USAGE_DEFAULT_COMMANDS();
+		return 0;
+	}
+
+	int print_status() override
+	{
+		PX4_INFO("active deterministic SIH attack schedule; scenario=%u", (unsigned)_last_scenario);
+		return 0;
+	}
+
+	bool init()
+	{
+		_start_time = hrt_absolute_time();
+		ScheduleOnInterval(50_ms);
+		PX4_INFO("SIH scenario schedule started (baseline 30s; GPS 30-42s, barometer 50-62s, command 70-72s)");
+		return true;
+	}
+
+	void Run() override
+	{
+		if (should_exit()) {
+			ScheduleClear();
+			exit_and_cleanup();
+			return;
+		}
+
+		const hrt_abstime now = hrt_absolute_time();
+		const float elapsed_s = (now - _start_time) * 1e-6f;
+		uint8_t scenario = drone_ids_sim_control_s::SCENARIO_NONE;
+		bool active = false;
+
+		if (elapsed_s >= 30.f && elapsed_s < 42.f) {
+			scenario = drone_ids_sim_control_s::SCENARIO_GPS_SPOOF;
+			active = true;
+
+		} else if (elapsed_s >= 50.f && elapsed_s < 62.f) {
+			scenario = drone_ids_sim_control_s::SCENARIO_BARO_TAMPER;
+			active = true;
+
+		} else if (elapsed_s >= 70.f && elapsed_s < 72.f) {
+			scenario = drone_ids_sim_control_s::SCENARIO_COMMAND_INJECTION;
+			active = true;
+		}
+
+		drone_ids_sim_control_s control{};
+		control.timestamp = now;
+		control.scenario = scenario;
+		control.active = active;
+		_control_pub.publish(control);
+
+		if (scenario != _last_scenario) {
+			_last_scenario = scenario;
+			debug_key_value_s truth{};
+			truth.timestamp = now;
+			strncpy(truth.key, "SIM_ATK", sizeof(truth.key) - 1);
+			truth.value = static_cast<float>(scenario);
+			_truth_log_pub.publish(truth);
+			PX4_INFO("SIM_ATTACK scenario=%u at %.2fs", (unsigned)scenario, (double)elapsed_s);
+		}
+
+		if (scenario == drone_ids_sim_control_s::SCENARIO_COMMAND_INJECTION && !_command_injected) {
+			vehicle_command_s command{};
+			command.timestamp = now;
+			command.command = 31010; // MAV_CMD_USER_1: non-actuating test command
+			command.target_system = 1;
+			command.target_component = 1;
+			command.source_system = 42; // Deliberately untrusted simulated sender
+			command.source_component = 190;
+			command.from_external = true;
+			command.confirmation = 0;
+			_command_pub.publish(command);
+			_command_injected = true;
+			PX4_WARN("SIM_ATTACK injected test-only MAV_CMD_USER_1 from system 42");
+		}
+	}
+
+private:
+	hrt_abstime _start_time{0};
+	uint8_t _last_scenario{255};
+	bool _command_injected{false};
+	uORB::Publication<drone_ids_sim_control_s> _control_pub{ORB_ID(drone_ids_sim_control)};
+	uORB::Publication<debug_key_value_s> _truth_log_pub{ORB_ID(debug_key_value)};
+	uORB::Publication<vehicle_command_s> _command_pub{ORB_ID(vehicle_command)};
+};
+
+extern "C" __EXPORT int drone_ids_sim_main(int argc, char *argv[])
+{
+	return DroneIdsSim::main(argc, argv);
+}
