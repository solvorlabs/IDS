@@ -0,0 +1,208 @@
+/****************************************************************************
+ * In-process, explainable SIH Drone IDS prototype.
+ * It consumes only simulated sensor and command observations. The simulator
+ * attack-label topic is deliberately not subscribed here.
+ ****************************************************************************/
+
+#include <px4_platform_common/log.h>
+#include <px4_platform_common/module.h>
+#include <px4_platform_common/px4_work_queue/ScheduledWorkItem.hpp>
+
+#include <uORB/Publication.hpp>
+#include <uORB/Subscription.hpp>
+#include <uORB/topics/debug_key_value.h>
+#include <uORB/topics/sensor_baro.h>
+#include <uORB/topics/sensor_gps.h>
+#include <uORB/topics/vehicle_command.h>
+
+#include <cmath>
+#include <cstring>
+
+using namespace time_literals;
+
+class DroneIds final : public ModuleBase<DroneIds>, public px4::ScheduledWorkItem
+{
+public:
+	DroneIds() : ScheduledWorkItem(MODULE_NAME, px4::wq_configurations::hp_default) {}
+	~DroneIds() override = default;
+
+	static int task_spawn(int argc, char *argv[])
+	{
+		DroneIds *instance = new DroneIds();
+
+		if (instance == nullptr) {
+			PX4_ERR("allocation failed");
+			return PX4_ERROR;
+		}
+
+		_object.store(instance);
+		_task_id = task_id_is_work_queue;
+
+		if (instance->init()) {
+			return PX4_OK;
+		}
+
+		delete instance;
+		_object.store(nullptr);
+		_task_id = -1;
+		return PX4_ERROR;
+	}
+
+	static int custom_command(int argc, char *argv[]) { return print_usage("unknown command"); }
+	static int print_usage(const char *reason = nullptr)
+	{
+		if (reason) { PX4_WARN("%s", reason); }
+		PRINT_MODULE_USAGE_NAME("drone_ids", "security");
+		PRINT_MODULE_USAGE_COMMAND("start");
+		PRINT_MODULE_USAGE_DEFAULT_COMMANDS();
+		return 0;
+	}
+
+	int print_status() override
+	{
+		PX4_INFO("alerts GPS=%u barometer=%u command=%u", (unsigned)_gps_alert_count,
+			 (unsigned)_baro_alert_count, (unsigned)_command_alert_count);
+		return 0;
+	}
+
+	bool init()
+	{
+		ScheduleOnInterval(20_ms);
+		PX4_INFO("observing sensor_gps, sensor_baro, and vehicle_command; SIM_ATTACK labels are excluded");
+		return true;
+	}
+
+	void Run() override
+	{
+		if (should_exit()) {
+			ScheduleClear();
+			exit_and_cleanup();
+			return;
+		}
+
+		sensor_gps_s gps{};
+
+		if (_gps_sub.update(&gps)) {
+			check_gps(gps);
+			_last_gps_altitude = (float)gps.altitude_msl_m;
+			_gps_ready = true;
+		}
+
+		sensor_baro_s baro{};
+
+		if (_baro_sub.update(&baro)) {
+			check_baro(baro);
+		}
+
+		vehicle_command_s command{};
+
+		if (_command_sub.update(&command)) {
+			check_command(command);
+		}
+	}
+
+private:
+	void check_gps(const sensor_gps_s &gps)
+	{
+		if (!_gps_reference_ready) {
+			_gps_reference_altitude = (float)gps.altitude_msl_m;
+		}
+
+		if (_gps_reference_ready && gps.timestamp_sample > _previous_gps.timestamp_sample) {
+			const float dt = (gps.timestamp_sample - _previous_gps.timestamp_sample) * 1e-6f;
+
+			if (dt > 0.04f && dt < 1.f) {
+				constexpr float kEarthMPerDeg = 111319.5f;
+				const float mean_lat_rad = (float)(0.5 * (gps.latitude_deg + _previous_gps.latitude_deg) * M_PI / 180.0);
+				const float north_delta = (float)(gps.latitude_deg - _previous_gps.latitude_deg) * kEarthMPerDeg;
+				const float east_delta = (float)(gps.longitude_deg - _previous_gps.longitude_deg) * kEarthMPerDeg * cosf(mean_lat_rad);
+				const float expected_north = 0.5f * (gps.vel_n_m_s + _previous_gps.vel_n_m_s) * dt;
+				const float expected_east = 0.5f * (gps.vel_e_m_s + _previous_gps.vel_e_m_s) * dt;
+				const float residual_m = hypotf(north_delta - expected_north, east_delta - expected_east);
+				const bool alert = residual_m > 8.f;
+
+				if (alert && !_gps_alert_active) {
+					emit_alert("IDS_GPS", residual_m);
+					++_gps_alert_count;
+					PX4_WARN("IDS_ALERT gps_position_velocity_residual=%.2fm", (double)residual_m);
+				}
+
+				_gps_alert_active = alert;
+			}
+		}
+
+		_previous_gps = gps;
+		_gps_reference_ready = true;
+	}
+
+	void check_baro(const sensor_baro_s &baro)
+	{
+		if (!_baro_reference_ready && baro.pressure > 1000.f) {
+			_baro_reference_pressure = baro.pressure;
+			_baro_reference_ready = true;
+			return;
+		}
+
+		if (!_baro_reference_ready || !_gps_ready || baro.pressure <= 1000.f) {
+			return;
+		}
+
+		const float baro_relative_altitude = 44330.f * (1.f - powf(baro.pressure / _baro_reference_pressure, 0.190294957f));
+		const float gps_relative_altitude = (float)_last_gps_altitude - _gps_reference_altitude;
+		const float residual_m = fabsf(gps_relative_altitude - baro_relative_altitude);
+		const bool alert = residual_m > 8.f;
+
+		if (alert && !_baro_alert_active) {
+			emit_alert("IDS_BARO", residual_m);
+			++_baro_alert_count;
+			PX4_WARN("IDS_ALERT gps_baro_altitude_residual=%.2fm", (double)residual_m);
+		}
+
+		_baro_alert_active = alert;
+	}
+
+	void check_command(const vehicle_command_s &command)
+	{
+		// PX4's normal GCS system ID is 255. Flag the controlled test sender ID 42.
+		if (command.from_external && command.source_system != 255 && !_command_alert_active) {
+			emit_alert("IDS_CMD", (float)command.source_system);
+			++_command_alert_count;
+			_command_alert_active = true;
+			PX4_WARN("IDS_ALERT unauthorized_vehicle_command source=%u command=%lu",
+				 (unsigned)command.source_system, (unsigned long)command.command);
+		}
+	}
+
+	void emit_alert(const char *key, float value)
+	{
+		debug_key_value_s alert{};
+		alert.timestamp = hrt_absolute_time();
+		strncpy(alert.key, key, sizeof(alert.key) - 1);
+		alert.value = value;
+		_alert_pub.publish(alert);
+	}
+
+	uORB::Subscription _gps_sub{ORB_ID(sensor_gps)};
+	uORB::Subscription _baro_sub{ORB_ID(sensor_baro)};
+	uORB::Subscription _command_sub{ORB_ID(vehicle_command)};
+	uORB::Publication<debug_key_value_s> _alert_pub{ORB_ID(debug_key_value)};
+
+	sensor_gps_s _previous_gps{};
+	float _gps_reference_altitude{0.f};
+	float _last_gps_altitude{0.f};
+	float _baro_reference_pressure{0.f};
+	uint32_t _gps_alert_count{0};
+	uint32_t _baro_alert_count{0};
+	uint32_t _command_alert_count{0};
+	bool _gps_reference_ready{false};
+	bool _baro_reference_ready{false};
+	bool _gps_ready{false};
+	bool _gps_alert_active{false};
+	bool _baro_alert_active{false};
+	bool _command_alert_active{false};
+};
+
+extern "C" __EXPORT int drone_ids_main(int argc, char *argv[])
+{
+	return DroneIds::main(argc, argv);
+}
